{
  "expo": {
    "name": "OrgTasks",
    "slug": "org_task_tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "orgtasks",
    "userInterfaceStyle": "automatic",
    "owner": "sage.hijazi",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hijazionline.orgtasks"
    },
    "android": {
      "package": "com.hijazionline.orgtasks",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "OrgTasks lets you attach a photo as proof when completing a task.",
          "cameraPermission": "OrgTasks lets you take a photo as proof when completing a task."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "530bebab-883e-4990-9221-1774115305ec"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/530bebab-883e-4990-9221-1774115305ec"
    }
  }
}
