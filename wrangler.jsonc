// Deploys the Expo web build (dist/) to Cloudflare, behind gate/index.js.
//
// Build first, then deploy:
//   npx expo export -p web
//   npx wrangler deploy
//
// CLOSED since 2026-09-27 (his call): gate/index.js shows everyone the
// "please delete it" page and lets only the owner through with his private
// link (DEV_KEY Worker secret). Reopen for everyone: SITE_CLOSED "0" + deploy.
//
// The gate runs first (run_worker_first) and hands the real app to
// env.ASSETS — which only exists because assets.binding is declared (an
// earlier gate without the binding 500'd on every route).
//
// not_found_handling is required because app.json leaves web.output at its
// default ("single"), so the export produces one index.html and expo-router
// resolves routes client-side. Without it, a direct hit on /signin 404s.
{
  "name": "rungs-web",
  "compatibility_date": "2026-08-09",
  "main": "gate/index.js",
  "vars": { "SITE_CLOSED": "1" },
  // Keep the *.workers.dev URL alive alongside the custom domain as a fallback
  // to hand testers if anything is ever wrong with the domain itself.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  // Subdomain only — the apex hijazionline.com stays on the separate
  // "sage-legal" worker (see ~/Projects/hijazionline-portfolio).
  // The old rungs.hijazionline.com is owned by the redirect worker in
  // ./redirect, which 301s every path to this domain.
  "routes": [
    { "pattern": "bdaudit.hijazionline.com", "custom_domain": true }
  ]
}
